<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
</head>

<body>
    <div>
        <h1>Products Page</h1>
        <div>
            <%= member.memberNick %>
                <% products.map( function(value, key) { %>
                    <p>
                        <%= value.productName %> - <%= value.productSize %>
                    </p>
                    <% }) %>
        </div>
    </div>
</body>

<%- include('includes/footer') %>